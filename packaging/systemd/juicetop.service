# System-wide collector. Runs as root so it can read the RAPL energy counters.
# Installed by `sudo juicetop service install`.
[Unit]
Description=juicetop power collector
Documentation=https://github.com/CookedApps/juicetop
After=nvidia-persistenced.service

[Service]
ExecStart=/usr/local/bin/juicetop daemon
Restart=on-failure
RestartSec=5
Nice=10

# /var/lib/juicetop (database) and /run/juicetop (live snapshot), readable by every user
StateDirectory=juicetop
StateDirectoryMode=0755
RuntimeDirectory=juicetop
RuntimeDirectoryMode=0755
UMask=0022

# The collector needs no network and writes nowhere else.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
